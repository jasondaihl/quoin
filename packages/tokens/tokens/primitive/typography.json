{
  "font-family": {
    "$type": "fontFamily",
    "sans": {
      "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
    },
    "mono": {
      "$value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace"
    }
  },

  "font-size": {
    "$type": "dimension",
    "xs": { "$value": "12px" },
    "sm": { "$value": "14px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "18px" },
    "xl": { "$value": "20px" },
    "2xl": { "$value": "24px" },
    "3xl": { "$value": "30px" }
  },

  "font-weight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "semibold": { "$value": 600 },
    "bold": { "$value": 700 }
  },

  "line-height": {
    "$type": "number",
    "tight": { "$value": 1.2 },
    "snug": { "$value": 1.35 },
    "normal": { "$value": 1.5 },
    "relaxed": { "$value": 1.65 }
  }
}
