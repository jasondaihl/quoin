{
  "color": {
    "$type": "color",
    "text": {
      "on-accent": { "$value": "{palette.neutral.950}" }
    },
    "accent": {
      "default": { "$value": "{palette.cyan.600}" },
      "hover": { "$value": "{palette.cyan.700}" },
      "active": { "$value": "{palette.cyan.800}" },
      "subtle": { "$value": "{palette.cyan.50}" }
    },
    "focus": {
      "ring": { "$value": "{palette.cyan.600}" }
    }
  }
}
