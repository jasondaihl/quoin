{
  "color": {
    "$type": "color",
    "bg": {
      "default": { "$value": "{palette.neutral.950}" },
      "subtle": { "$value": "{palette.neutral.900}" }
    },
    "surface": {
      "default": { "$value": "{palette.neutral.900}" },
      "raised": { "$value": "{palette.neutral.800}" }
    },
    "text": {
      "default": { "$value": "{palette.neutral.50}" },
      "muted": { "$value": "{palette.neutral.400}" },
      "on-accent": { "$value": "{palette.neutral.0}" },
      "on-danger": { "$value": "{palette.neutral.0}" }
    },
    "border": {
      "default": { "$value": "{palette.neutral.800}" },
      "strong": { "$value": "{palette.neutral.500}" }
    },
    "accent": {
      "default": { "$value": "{palette.indigo.600}" },
      "hover": { "$value": "{palette.indigo.500}" },
      "active": { "$value": "{palette.indigo.400}" },
      "subtle": { "$value": "{palette.indigo.900}" }
    },
    "focus": {
      "ring": { "$value": "{palette.indigo.400}" }
    },
    "danger": {
      "default": { "$value": "{palette.red.600}" },
      "hover": { "$value": "{palette.red.700}" }
    },
    "success": {
      "default": { "$value": "{palette.green.500}" }
    }
