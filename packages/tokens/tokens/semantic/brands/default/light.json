{
  "color": {
    "$type": "color",
    "bg": {
      "default": { "$value": "{palette.neutral.0}" },
      "subtle": { "$value": "{palette.neutral.50}" }
    },
    "surface": {
      "default": { "$value": "{palette.neutral.0}" },
      "raised": { "$value": "{palette.neutral.0}" }
    },
    "text": {
      "default": { "$value": "{palette.neutral.900}" },
      "muted": { "$value": "{palette.neutral.500}" },
      "on-accent": { "$value": "{palette.neutral.0}" },
      "on-danger": { "$value": "{palette.neutral.0}" }
    },
    "border": {
      "default": { "$value": "{palette.neutral.200}" },
      "strong": { "$value": "{palette.neutral.500}" }
    },
    "accent": {
      "default": { "$value": "{palette.indigo.600}" },
      "hover": { "$value": "{palette.indigo.700}" },
      "active": { "$value": "{palette.indigo.800}" },
      "subtle": { "$value": "{palette.indigo.50}" }
    },
    "focus": {
      "ring": { "$value": "{palette.indigo.500}" }
    },
    "danger": {
      "default": { "$value": "{palette.red.600}" },
      "hover": { "$value": "{palette.red.700}" }
    },
    "success": {
      "default": { "$value": "{palette.green.600}" }
    }
  }
}
