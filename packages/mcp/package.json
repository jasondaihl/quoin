{
  "name": "@jasondaihl/quoin-mcp",
  "version": "0.2.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasondaihl/quoin.git",
    "directory": "packages/mcp"
  },
  "description": "quoin MCP — a Model Context Protocol server exposing quoin's design tokens and component APIs to AI assistants.",
  "type": "module",
  "files": ["dist"],
  "bin": {
    "quoin-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@jasondaihl/quoin-core": "workspace:*",
    "@jasondaihl/quoin-tokens": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
