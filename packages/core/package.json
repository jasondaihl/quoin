{
  "name": "@jasondaihl/quoin-core",
  "version": "0.2.4",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasondaihl/quoin.git",
    "directory": "packages/core"
  },
  "description": "quoin core — framework-agnostic web components built with Lit.",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "dist/custom-elements.json",
  "sideEffects": true,
  "scripts": {
    "build": "tsup && cem analyze",
    "analyze": "cem analyze",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@jasondaihl/quoin-tokens": "workspace:*",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/web-components-vite": "^10.6.2",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "axe-core": "^4.14.0",
    "playwright": "^1.49.1",
    "storybook": "^10.6.2",
    "tsup": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
