{
  "name": "quoin",
  "version": "0.0.0",
  "private": true,
  "description": "quoin — a personal design system: design tokens + framework-agnostic web components with React wrappers.",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version-packages": "changeset version && biome format --write .",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^2.27.11",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@biomejs/biome", "msw"],
    "overrides": {
      "vite": "^6.4.4",
      "@vitest/mocker": "^4.1.11"
    }
  }
}
